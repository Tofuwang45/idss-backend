# =============================================================================
# IDSS Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# OpenAI API key for LLM features (question generation, semantic parsing)
OPENAI_API_KEY="sk-REPLACE-ME"

# PostgreSQL connection string for e-commerce products (laptops, books)
# Format: postgresql://USERNAME@localhost:5432/DATABASE_NAME
# On Mac, USERNAME is usually your system username
DATABASE_URL="postgresql://your_username@localhost:5432/mcp_ecommerce"

# Supabase REST API credentials — required for vehicle search and product store
# Find these in your Supabase project: Settings → API
# SUPABASE_URL = Project URL (e.g. https://xxxx.supabase.co)
# SUPABASE_KEY = anon/public key (or service_role key for server-side)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-role-key"

# -----------------------------------------------------------------------------
# Optional - Logging
# -----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Optional - Redis (for session caching)
# -----------------------------------------------------------------------------
# If Redis is not available, the system falls back to in-memory sessions

REDIS_HOST=localhost
REDIS_PORT=6379

# Upstash cloud-hosted Redis (overrides REDIS_HOST/REDIS_PORT if set)
# Get your URL from https://console.upstash.com → Redis → Details → REST URL
# UPSTASH_REDIS_URL="rediss://default:your-password@your-endpoint.upstash.io:6379"

# Cache TTLs (seconds) — tune per freshness requirements
# CACHE_TTL_PRODUCT_SUMMARY=300   # 5 min  (product data rarely changes)
# CACHE_TTL_PRICE=60              # 1 min  (prices change frequently)
# CACHE_TTL_INVENTORY=30          # 30 sec (most volatile)
# CACHE_TTL_SEARCH=300            # 5 min  (repeated searches)

# -----------------------------------------------------------------------------
# Optional - Neo4j (for knowledge graph - future feature)
# -----------------------------------------------------------------------------

# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-password

# -----------------------------------------------------------------------------
# Optional - IDSS Server Settings
# -----------------------------------------------------------------------------

# Skip model preloading for faster startup (models load on first request)
# Set to 1 for development, 0 for production
# IDSS_SKIP_PRELOAD=0

# Preload all recommendation methods (uses more memory but faster switching)
# Set to 0 to only preload the configured method
# IDSS_PRELOAD_ALL=1

# -----------------------------------------------------------------------------
# Optional - Agent → MCP (UCP over HTTP)
# -----------------------------------------------------------------------------
# Base URL of the MCP server. The agent (action endpoints) sends UCP requests here.
# Default: http://localhost:8001 (same host when agent and MCP run together)
# When agent and MCP are separate services, set to the MCP server URL.
# MCP_BASE_URL="http://localhost:8001"

# Timeout in seconds for UCP HTTP calls from agent to MCP
# UCP_REQUEST_TIMEOUT=30.0

# -----------------------------------------------------------------------------
# Optional - Commerce Protocol Selection
# -----------------------------------------------------------------------------
# Which protocol the AI shopping agent uses for outbound commerce calls.
# The merchant server (MCP server) accepts BOTH protocols regardless of this setting.
#   "ucp" — Google Universal Commerce Protocol (default)
#   "acp" — OpenAI/Stripe Agentic Commerce Protocol
COMMERCE_PROTOCOL=ucp

# -----------------------------------------------------------------------------
# Optional - Multi-channel messaging (Slack, WhatsApp, Telegram)
# -----------------------------------------------------------------------------
# Slack bot integration — receive and reply to messages via the IDSS assistant.
# Setup: https://api.slack.com/apps → Create App → Enable Events API
#   Request URL: https://<your-host>/channels/slack/events
#   Bot event subscriptions: message.channels, message.im, app_mention
#   OAuth scopes: chat:write, channels:history, im:history, im:write
# SLACK_BOT_TOKEN="xoxb-your-bot-oauth-token"
# SLACK_SIGNING_SECRET="your-signing-secret"

# -----------------------------------------------------------------------------
# Optional - eBay APIs & Merchant Reliability Engine (MRE)
# -----------------------------------------------------------------------------

# eBay Finding API key (existing — used by /search/ebay)
# EBAY_APP_ID=

# eBay Browse API OAuth credentials (for rich seller profiles)
# EBAY_OAUTH_CLIENT_ID=
# EBAY_OAUTH_CLIENT_SECRET=

# SANDBOX or PRODUCTION
EBAY_ENVIRONMENT=SANDBOX

# When sold comparables are empty, web FMV can fall back to "active_market"
# (asking prices from the same live search). Default in code is now **off**
# (0) so the UI does not imply sold-based FMV when there is none. Set to 1
# only if you explicitly want that snapshot behaviour.
# FMV_ALLOW_ACTIVE_MARKET_FALLBACK=0

# When sold comps count is below this after the primary query, re-run SerpAPI
# using catalog product names + live listing titles as keywords (default 5).
# FMV_TITLE_HINT_MIN_COMPARABLES=5
# Max distinct SerpAPI title-hint calls per web search (default 5).
# FMV_TITLE_HINT_MAX_CALLS=5

# -----------------------------------------------------------------------------
# Optional - SerpAPI (eBay engine) — historical pricing augmentation
# -----------------------------------------------------------------------------
# Used as a second-opinion source for sold comparables + price history when
# the eBay Finding API is rate-limited or returns too few rows. Treat the key
# as a production secret; never commit to git or expose to browser bundles.
#
# Rotate on leak:
#   https://serpapi.com/manage-api-key
#
# SERPAPI_API_KEY="your-serpapi-key"
# FMV_SERPAPI_ENABLED=1           # 0 disables the fallback entirely
# FMV_SERPAPI_EBAY_SOP=12         # eBay sort _sop for SerpAPI (12=best match; see serpapi.com/ebay-sort-options)
# SERPAPI_TIMEOUT=10              # per-request timeout in seconds
# SERPAPI_CACHE_TTL=900           # cache successful responses for 15 min
# SERPAPI_CACHE_FAIL_TTL=90       # cache empty / error responses briefly

# Master toggle for the Merchant Reliability Engine (0=off, 1=on; default on if unset)
MERCHANT_RELIABILITY_ENABLED=1

# Optional LLM sentiment analysis on seller/item text (0=off, 1=on)
# Requires MERCHANT_RELIABILITY_ENABLED=1 and a valid OPENAI_API_KEY
MERCHANT_LLM_SENTIMENT=0

# LLM-powered seller communication drafts for the Deal Analysis endpoint (0=off, 1=on)
# When off, uses template-based message generation (no LLM cost)
DEAL_LLM_COMMS=0

# -----------------------------------------------------------------------------
# Optional - SerpAPI (historical sold-price augmentation)
# -----------------------------------------------------------------------------
# SerpAPI's eBay engine acts as a second source of sold/completed comparables
# for the FMV pipeline. It's used *only as augmentation* when eBay's Finding
# API returns too few sold items (e.g. rate-limited, 10001 errors, or narrow
# queries). When enough comps come back from eBay directly, SerpAPI is never
# called and you incur zero cost.
#
# How to obtain a key:
#   1. Create an account at https://serpapi.com/ (the free tier includes 100
#      searches/month — enough for development).
#   2. Copy the API key from https://serpapi.com/manage-api-key
#   3. Set it below and restart the MCP server.
#
# Rotation / safety:
#   - Keys are per-account. Rotate via the SerpAPI dashboard if a key leaks;
#     the old key is invalidated server-side within a minute.
#   - Never commit .env to the repo. Use a secret manager in production.
#   - Each SerpAPI request counts against your plan even on cache misses, so
#     tuning `SERPAPI_CACHE_TTL` (below) matters for cost.
# SERPAPI_API_KEY="your-serpapi-key"

# Master toggle for the SerpAPI fallback (default on when a key is set).
# Set to 0 to force eBay-only operation regardless of the API key.
# FMV_SERPAPI_ENABLED=1

# Request timeout (seconds) and cache TTLs for SerpAPI responses.
# - SERPAPI_CACHE_TTL applies to successful responses (900 = 15 min)
# - SERPAPI_CACHE_FAIL_TTL applies to empty/failed responses (90 = 90 sec)
# SERPAPI_TIMEOUT=10
# SERPAPI_CACHE_TTL=900
# SERPAPI_CACHE_FAIL_TTL=90

# -----------------------------------------------------------------------------
# Optional - SerpAPI (sold-comparables fallback & price-history augmentation)
# -----------------------------------------------------------------------------
# Used by app.serpapi_ebay to fetch sold / completed eBay listings when the
# eBay Finding API is rate-limited or returns too few comparables. Same data
# also powers the "Sold history" sparkline shown on marketplace listing cards.
#
# Get a key: https://serpapi.com/ebay-search-api  (free tier: 250 searches/mo)
# SECURITY: treat this like any other outbound API key — rotate on leak,
# never commit the actual value, and scope the key to a single service if
# your plan allows. Costs scale with the number of unique (keywords, condition,
# max_price) tuples you evaluate, so keep `SERPAPI_CACHE_TTL` generous.
# SERPAPI_API_KEY="your-serpapi-key"

# Feature flag — set to 0 to disable SerpAPI completely without rotating the
# key (e.g. during a cost incident). Defaults to on when the key is present.
# FMV_SERPAPI_ENABLED=1

# HTTP timeout for outbound SerpAPI requests (seconds; default 10).
# SERPAPI_TIMEOUT=10

# Cache TTL for successful SerpAPI responses (seconds; default 15 min).
# Shorter = fresher comps, longer = fewer API calls.
# SERPAPI_CACHE_TTL=900

# Cache TTL for empty / failed SerpAPI responses (seconds; default 90).
# Short on purpose so transient upstream issues don't poison the cache.
# SERPAPI_CACHE_FAIL_TTL=90
